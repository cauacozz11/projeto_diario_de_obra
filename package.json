{
  "name": "projeto_diario_de_obra",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:up": "docker compose --env-file .env -f infra/docker-compose.yaml up -d",
    "db:down": "docker compose --env-file .env --env-file .env -f infra/docker-compose.yaml down",
    "db:restart": "docker compose --env-file .env -f infra/docker-compose.yaml down && docker compose -f infra/docker-compose.yaml up -d",
    "test": "jest",
    "test:watch": "jest --watchAll"
  },
  "dependencies": {
    "@prisma/client": "^7.7.0",
    "next": "16.2.3",
    "prisma": "^7.7.0",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.12",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.3",
    "jest": "^30.3.0",
    "jest-environment-jsdom": "^30.3.0",
    "ts-node": "^10.9.2",
    "typescript": "^5"
  }
}
